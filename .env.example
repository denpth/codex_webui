# Network
PORT=5055
HOST=127.0.0.1
# If exposing behind a proxy, set your site origin explicitly
ALLOW_ORIGIN=http://localhost:5055
# Optional bearer token for write routes (POST/PUT/DELETE)
WEBUI_TOKEN=change-me


# Codex process
CODEX_CMD=codex
# Optional: change the working directory Codex uses (defaults to project root)
# CODEX_WORKDIR=/path/to/project


# Memory file path (defaults to $CODEX_WORKDIR/.codex/memory.md)
# CODEX_MEMORY_FILE=/path/to/.codex/memory.md


# Auto-resume latest rollout on first start (1=true, 0=false)
CODEX_RESUME=1
# Persistent terminals require tmux 3.2+ on a Unix host
# TMUX_CMD=/opt/homebrew/bin/tmux
# Optional dedicated socket name (defaults to a hash of CODEX_WORKDIR)
# WEBUI_TMUX_SOCKET=codex-webui
